# --- Microsoft Graph / SharePoint (Azure AD app registration) ---
# Register an app in Entra ID admin center with Application permissions:
#   Sites.Read.All  (or Sites.Selected scoped to just the Reservations site)
#   Files.Read.All
#   Mail.Send        (only needed for the nightly alert email below)
# Grant admin consent, then create a client secret.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# The SharePoint site hosting "Reservations". Find via:
# https://graph.microsoft.com/v1.0/sites/{tenant}.sharepoint.com:/sites/Reservations
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# --- Supabase ---
# Use the service_role key here (server-side only, never exposed to the frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Nightly alert email (optional) ---
# Sent via Graph "as" the mailbox below, using the Mail.Send application
# permission above — app-only auth has no signed-in user of its own, so
# ALERT_EMAIL_FROM must be a real mailbox in your tenant. Leave both blank
# to disable email alerts entirely (the run still logs to the console and
# to data_quality_log either way).
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# By default an email only sends when something needs attention (a critical
# finding, a SharePoint access error, etc.) — set this to "true" to instead
# get a summary email every run, clean or not.
ALERT_ALWAYS=false
