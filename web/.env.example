# Same Supabase project as the ingestion job, but the ANON key (safe for
# the browser) rather than the service_role key.
# Configure Row Level Security so authenticated users get read-only access
# to clean_reservations, data_quality_log, budget, and the v_monthly_revenue view.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
